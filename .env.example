# Copy this file to .env and fill in real values. .env is git-ignored.

# PostgreSQL - used by both docker-compose.yml (to create the container's
# database/role) and the Python app (to connect to it). Port 5433 (not the
# default 5432) so this project's isolated container doesn't collide with
# any other Postgres already running on this machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=investigator
POSTGRES_USER=investigator
POSTGRES_PASSWORD=change-me

# Qdrant - used by both docker-compose.yml and the Python app. Host ports
# 16333/16334 (not Qdrant's default 6333/6334) because that default range
# collides with a Windows Hyper-V excluded-port range on some machines;
# adjust freely for your own environment.
QDRANT_HOST=localhost
QDRANT_PORT=16333
QDRANT_GRPC_PORT=16334
QDRANT_COLLECTION=manufacturing_knowledge

# Claude Agent SDK - optional. If unset, the SDK falls back to an existing
# local `claude` CLI login (see app/config.py).
ANTHROPIC_API_KEY=

# Model tiering (performance - see app/config.py). Defaults: a fast model
# for the four specialists (simple tool-selection/summarization), a
# mid-tier model for the Supervisor's own cross-specialist synthesis.
# Accepts an SDK model alias ("haiku"/"sonnet"/"opus"/"inherit") or a full
# model ID. Only change these after re-running the real performance
# scenario (python -m app.e2e_report) - do not tune blindly.
SPECIALIST_MODEL=haiku
SUPERVISOR_MODEL=sonnet
SPECIALIST_MAX_TURNS=8
SUPERVISOR_MAX_TURNS=8

# Login sessions (app/security.py) - optional for local dev. If unset, a
# random secret is generated per process, so restarting the server logs
# everyone out. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Demo login accounts created by `python -m app.database.seed` (see
# app/database/auth_repository.py). Optional - default to admin123/user123
# if unset. Change these for anything beyond a local demo.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
